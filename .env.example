# Copy this file to .env and fill in the values.
# Firebase project for this combined site: idayuismail-e4526

NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Firebase (public - safe to expose to the browser) ----
# Firebase console > idayuismail-e4526 > Project settings > Your apps > SDK setup
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=idayuismail-e4526.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=idayuismail-e4526
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=idayuismail-e4526.firebasestorage.app
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- Admin dashboard (server-only) ----
NUXT_ADMIN_PASSWORD=
# openssl rand -hex 32
NUXT_ADMIN_SESSION_SECRET=

# ---- Cloudinary (cover photo uploads) ----
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NUXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---- Email (Resend) ----
NUXT_RESEND_API_KEY=
NUXT_RESEND_FROM_EMAIL=

# ---- Payment (ToyyibPay) ----
# Sandbox: https://dev.toyyibpay.com | Production: https://toyyibpay.com
NUXT_TOYYIBPAY_SECRET_KEY=
NUXT_TOYYIBPAY_CATEGORY_CODE=
NUXT_TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com

# ---- Google Drive OAuth (optional) ----
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
NUXT_GOOGLE_REDIRECT_URI=

# ---- Firebase Admin SDK (server-only) ----
# Firebase console > idayuismail-e4526 > Project settings > Service accounts
# > Generate new private key; paste the whole JSON on one line.
NUXT_FIREBASE_SERVICE_ACCOUNT_JSON=


# ---- Portfolio section (embedded at /portfolio) ----
# Turso database connection for the portfolio content.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Key required to edit portfolio content via /portfolio/admin.
ADMIN_API_KEY=
# Powers the "Ask about Idayu" chat widget (paid Anthropic API).
ANTHROPIC_API_KEY=
