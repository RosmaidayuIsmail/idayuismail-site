rules_version = '2';

// Paste into Firebase Console > Storage > Rules, or deploy with
// `firebase deploy --only storage`.
//
// Note on the limitation here: unlike the Firestore rules, this does not
// verify the uploader actually owns the wedding at path weddings/{weddingId}/*
// - it only checks that *some* signed-in user is uploading. The app itself
// only ever constructs upload paths for the couple's own wedding, but that's
// an app-level guarantee, not a rules-level one. Tightening this to a true
// ownership check requires the newer `firestore.get()` cross-reference
// syntax in Storage rules (Blaze plan) - worth adding if this matters for
// your use case.
service firebase.storage {
  match /b/{bucket}/o {
    match /weddings/{weddingId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
