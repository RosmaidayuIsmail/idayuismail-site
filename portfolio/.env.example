# Turso database connection. Leave both blank to use a local SQLite file
# (local.db) for development — the app falls back to that automatically.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required to add/edit/delete content via the API or the /admin page.
# Make up any long random string.
ADMIN_API_KEY=

# Powers the "Ask about Idayu" chat widget. Get a key from
# console.anthropic.com — this is a paid API (usage-based, quite cheap for
# a low-traffic personal site with the Haiku model, but not free). Leave
# blank to disable the chat widget's backend (the button still shows, but
# messages will fail with a clear error instead of the site breaking).
ANTHROPIC_API_KEY=
